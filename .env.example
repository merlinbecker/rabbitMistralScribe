# GitHub OAuth App Credentials
# Create a GitHub OAuth App at: https://github.com/settings/developers
# 
# IMPORTANT: Set the Authorization callback URL in your GitHub OAuth App to:
# For local development: http://localhost:5000/api/auth/github/callback
# For production: https://your-repl-url.replit.dev/api/auth/github/callback
#
# Replace 'your-repl-url' with your actual Repl URL
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Session Secret (generate a random string for production)
SESSION_SECRET=your_session_secret

# Mistral API Configuration
# Model to use for audio transcription (Speech-to-Text)
MISTRAL_STT_MODEL=voxtral-24.02
# Model to use for text summarization
MISTRAL_SUMMARIZER_MODEL=mistral-large-latest

# Optional: Set this to your Repl's public URL in production
# This is used to construct the OAuth callback URL
# Example: https://your-repl-name.your-username.repl.co
# If not set, defaults to http://localhost:5000 in development
REPL_HOME=

# These are set automatically by the GitHub connector integration:
# - GitHub connection credentials for API access
# The user's Mistral API key will be stored in the database (BYOK approach)