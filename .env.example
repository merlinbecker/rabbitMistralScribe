# GitHub OAuth App Credentials
# Create a GitHub OAuth App at: https://github.com/settings/developers
# Authorization callback URL: https://your-repl-url.replit.dev/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Session Secret (automatically generated by Replit)
SESSION_SECRET=your_session_secret

# These are set automatically by the GitHub connector integration:
# - GitHub connection credentials for API access
# The user's Mistral API key will be stored in the database (BYOK approach)
